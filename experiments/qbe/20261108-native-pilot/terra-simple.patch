+/* Signed word division by a positive non-power-of-two constant.  Find a
+ * reciprocal multiplier and shift as in Hacker's Delight, section 10-4.
+ * All arithmetic here is unsigned: the intermediate doubling can wrap.
+ */
+static uint32_t
+divmagic(uint32_t d, int *shift)
+{
+	uint32_t a, q1, r1, q2, r2, delta, m;
+	int p;
+
+	a = UINT32_C(0x7fffffff) - UINT32_C(0x80000000) % d;
+	q1 = UINT32_C(0x80000000) / a;
+	r1 = UINT32_C(0x80000000) % a;
+	q2 = UINT32_C(0x80000000) / d;
+	r2 = UINT32_C(0x80000000) % d;
+	p = 31;
+	do {
+		p++;
+		q1 *= 2;
+		r1 *= 2;
+		if (r1 >= a) {
+			q1++;
+			r1 -= a;
+		}
+		q2 *= 2;
+		r2 *= 2;
+		if (r2 >= d) {
+			q2++;
+			r2 -= d;
+		}
+		delta = d - r2;
+	} while (q1 < delta || (q1 == delta && r1 == 0));
+	*shift = p - 32;
+	m = q2 + 1;
+	return m;
+}
+
+/* Emit in reverse order, as required by emit(). */
+static void
+divword(Ins *i, uint32_t d, int neg, Fn *fn)
+{
+	Ref x, x64, prod, high, sign, q, rem;
+	uint32_t magic;
+	int shift;
+
+	magic = divmagic(d, &shift);
+	x = i->arg[0];
+	x64 = newtmp("divx", Kl, fn);
+	prod = newtmp("divprod", Kl, fn);
+	high = newtmp("divhigh", Kl, fn);
+	sign = newtmp("divsign", Kw, fn);
+	q = (i->op == Orem || neg) ? newtmp("divq", Kw, fn) : i->to;
+	if (i->op == Orem) {
+		rem = newtmp("divrem", Kw, fn);
+		emit(Osub, Kw, i->to, x, rem);
+		emit(Omul, Kw, rem, q, getcon(d, fn));
+	} else if (neg)
+		emit(Oneg, Kw, i->to, q, R);
+	/* Treating the reciprocal as unsigned incorporates the usual
+	 * signed-high correction when its top bit is set.  The widened
+	 * signed product fits in 64 bits.  Arithmetic shift rounds down;
+	 * add the original dividend's sign bit to round toward zero.
+	 */
+	emit(Oadd, Kw, q, high, sign);
+	emit(Oshr, Kw, sign, x, getcon(31, fn));
+	emit(Osar, Kl, high, prod, getcon(32 + shift, fn));
+	emit(Omul, Kl, prod, x64, getcon(magic, fn));
+	emit(Oextsw, Kl, x64, x, R);
+}
+
+/* Replace safe constant divisions with nontrapping integer operations.
+ * Signed division rounds toward zero rather than toward negative infinity,
+ * so powers of two need a bias for negative dividends.  The pass runs
+ * before GVN/GCM so the new operations can be shared and moved out of
+ * loops, and again afterward for newly exposed constants.
+ */
+void
+divopt(Fn *fn)
+{
+	Blk *b;
+	Ins *i;
+	Ref x, sign, bias, sum, part;
+	uint64_t d, mask;
+	int k, w, n, neg, changed;
+	ulong ni;
+
+	if (!T.divconst)
+		return;
+	for (b=fn->start; b; b=b->link) {
+		changed = 0;
+		for (i=&b->ins[b->nins]; i!=b->ins;) {
+			--i;
+			k = i->cls;
+			if ((i->op != Odiv && i->op != Orem)
+			|| KBASE(k) != 0
+			|| rtype(i->arg[1]) != RCon
+			|| fn->con[i->arg[1].val].type != CBits
+			|| rtype(i->arg[0]) == RCon)
+				goto Copy;
+
+			w = k == Kl ? 64 : 32;
+			d = (uint64_t)fn->con[i->arg[1].val].bits.i;
+			if (w == 32)
+				d = (uint32_t)d;
+			neg = (d >> (w-1)) != 0;
+			if (neg) {
+				d = -d;
+				if (w == 32)
+					d = (uint32_t)d;
+			}
+			if (!ispow2(d)) {
+				if (k != Kw || d == 0)
+					goto Copy;
+				if (!changed) {
+					curi = &insb[NIns];
+					ni = &b->ins[b->nins] - (i+1);
+					curi -= ni;
+					icpy(curi, i+1, ni);
+					changed = 1;
+				}
+				divword(i, d, neg, fn);
+				continue;
+			}
+			if (neg && d == 1)
+				goto Copy;
+			n = ulog2(d);
+			mask = d - 1;
+
+			if (n == 0) {
+				if (i->op == Odiv)
+					i->op = Ocopy;
+				else {
+					i->op = Ocopy;
+					i->arg[0] = CON_Z;
+				}
+				i->arg[1] = R;
+				goto Copy;
+			}
+
+			if (!changed) {
+				curi = &insb[NIns];
+				ni = &b->ins[b->nins] - (i+1);
+				curi -= ni;
+				icpy(curi, i+1, ni);
+				changed = 1;
+			}
+			x = i->arg[0];
+			bias = newtmp("divbias", k, fn);
+			sum = newtmp("divsum", k, fn);
+			if (i->op == Odiv) {
+				part = neg ? newtmp("divq", k, fn) : i->to;
+				if (neg)
+					emit(Oneg, k, i->to, part, R);
+				emit(Osar, k, part, sum, getcon(n, fn));
+			} else {
+				part = newtmp("divrem", k, fn);
+				emit(Osub, k, i->to, part, bias);
+				emit(Oand, k, part, sum, getcon(mask, fn));
+			}
+			emit(Oadd, k, sum, x, bias);
+			if (n == 1)
+				emit(Oshr, k, bias, x, getcon(w-1, fn));
+			else {
+				sign = newtmp("divsign", k, fn);
+				if (k == Kl && n >= 32)
+					emit(Oshr, k, bias, sign, getcon(w-n, fn));
+				else
+					emit(Oand, k, bias, sign, getcon(mask, fn));
+				emit(Osar, k, sign, x, getcon(w-1, fn));
+			}
+			continue;
+		Copy:
+			if (changed)
+				emiti(*i);
+		}
+		if (changed)
+			idup(b, curi, &insb[NIns]-curi);
+	}
+}
