+# Sink nested address and branch expressions shared across blocks.
+
+export
+function w $gcmsink(l %base, l %index, w %side, w %selector) {
+@start
+	%next =l add %index, 1
+	%scaled =l mul %next, 4
+	%address =l add %base, %scaled
+	%shifted =w add %selector, 3
+	%gate =w and %shifted, 1
+	jnz %side, @left, @right
+@left
+	%lv =w loadw %address
+	%inc =w add %lv, 17
+	storew %inc, %address
+	jnz %gate, @left_true, @left_false
+@left_true
+	%lt =w add %inc, 100
+	ret %lt
+@left_false
+	%lf =w sub %inc, 100
+	ret %lf
+@right
+	%rv =w loadw %address
+	%dec =w sub %rv, 23
+	storew %dec, %address
+	jnz %gate, @right_true, @right_false
+@right_true
+	%rt =w add %dec, 200
+	ret %rt
+@right_false
+	%rf =w sub %dec, 200
+	ret %rf
+}
