    "activation": [],
    "documentation": [
      "https://github.com/ARM-software/acle"
    ],
    "examples": [
      {
        "command": "python3 \"{prefix}/verify.py\" --root \"{prefix}\"",
        "description": "Verify all distributed material and query behavior"
      },
      {
        "command": "python3 \"{prefix}/reader.py\" --help",
        "description": "Read command help for source-aware offline search"
      }
    ],
    "locations": [
      {
