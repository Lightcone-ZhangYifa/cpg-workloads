        "https://github.com/renatahodovan/picire/tree/e07644450c544b00cf32fe076dd997ffb06eb06c"
      ],
      "examples": [
        {
          "command": "{prefix}/bin/picire --version",
          "description": "Report the independently installed Picire version."
        },
        {
          "command": "{prefix}/bin/picire --test=./interesting.sh --input=case.c --out=reduced --atom=line",
          "description": "Reduce with an explicit interestingness test; its exit status determines retained candidates."
        },
        {
          "command": "{prefix}/runtime/bin/python -I -c \"import picire; print(picire.__version__)\"",
          "description": "Use the API through this prefix own interpreter and installed distributions."
        }
      ],
      "locations": [
        {
          "label": "CLI launcher",
          "path": "{prefix}/bin/picire",
          "purpose": "Select this installation own interpreter without globally activating a virtual environment."
        },
        {
          "label": "Independent Python environment",
          "path": "{prefix}/runtime",
          "purpose": "Pinned private runtime, build and upstream-test distributions."
        },
        {
          "label": "Unmodified original source",
          "path": "{prefix}/share/picire/source",
          "purpose": "Every source, test, fixture and license from the original fixed archive."
        },
        {
          "label": "Exact private inputs",
          "path": "{prefix}/share/picire/wheels",
          "purpose": "Locked wheel payloads retained for offline reinstallation."
        },
        {
          "label": "Profile and compatibility patch",
          "path": "{prefix}/share/picire/profile.json",
          "purpose": "Interpreter, original source, installed wheel and patch identities."
        }
      ],
      "notes": [
        "The original source archive remains unchanged. Only a build copy replaces pkg_resources version lookup with importlib.metadata, with original and result SHA-256 checks.",
        "The private dependency closure adds no resource IDs and changes no global Python environment or existing wheel pins.",
        "Source installs create fresh venvs with copied interpreters and never invoke online pip or share installation trees.",
        "The tested native scope is the unmodified upstream API/CLI matrix plus known-answer sequential/parallel reductions, one-minimality, invalid input and independent source-install removal.",
        "Virtualenvs are rebuilt through the source-input artifact; no arbitrary-prefix binary relocatability or cross-platform qualification is claimed."
      ],
      "summary": "Run the pinned Picire delta-debugging API and CLI in a private, fully offline CPython 3.12 environment."
    },
