  "usage": {
    "activation": [
      "No activation is required after APT installation. Use the explicit /usr/bin executable."
    ],
    "documentation": [
      "https://strace.io/",
      "https://man7.org/linux/man-pages/man1/strace.1.html"
    ],
    "examples": [
      {
        "command": "/usr/bin/strace -f -tt -T -s 256 -o compiler.trace ./compiler input.c -o program",
        "description": "Trace a fresh child and descendants, retain timestamps and syscall durations."
      },
      {
        "command": "/usr/bin/strace -f -e trace=%file,%process -o compiler-files.trace ./compiler input.c -o program",
        "description": "Inspect only file and process activity."
      },
      {
        "command": "/usr/bin/strace -f -c ./compiler input.c -o program",
        "description": "Summarize syscall counts and observed syscall time."
      },
      {
        "command": "cpg packages check apt.strace --kind hardware",
        "description": "Run the host-sensitive tracing operation check; denied ptrace is recorded as blocked."
      },
      {
        "command": "cpg packages check apt.strace --kind functional",
        "description": "Validate actual tracing after the host capability check passes."
      }
    ],
    "locations": [
      {
        "label": "Tracer executable",
        "path": "/usr/bin/strace",
        "purpose": "Actual executable owned by the exact system package."
      },
      {
        "label": "Prepared material",
        "path": "{assets}/apt/strace_6.8-0ubuntu2_amd64.deb",
        "purpose": "Independent verified source, input, data or upstream distribution."
      },
      {
        "label": "System package files",
        "path": "/var/lib/dpkg/info/strace.list",
        "purpose": "Ask dpkg-query -L for the actual installed file list, including multiarch packages."
      }
    ],
    "notes": [
      "The check compiles and traces a real child twice, verifies file writes and decoded ENOENT, and requires propagation of child exit codes 0 and 7.",
      "Tracing depends on kernel ptrace permission, container seccomp/capabilities and process ownership. A denied trace is blocked; the check does not alter host policy or attach to unrelated processes.",
      "Syscall tracing perturbs the workload. Its durations/counts support diagnosis and do not replace an official benchmark measurement.",
      "The upstream version probe and the exact Debian package identity are separate checks. A privately extracted Debian package is not an APT install/remove transaction.",
      "The host-sensitive capability check records denied ptrace as blocked. The separate functional check performs the complete trace assertions on a capable host; neither check measures physical hardware performance."
    ],
    "summary": "Trace Linux system calls and signals to diagnose compiler file access, subprocesses, failed syscalls and process termination."
  },
  "version": "6.8-0ubuntu2"
