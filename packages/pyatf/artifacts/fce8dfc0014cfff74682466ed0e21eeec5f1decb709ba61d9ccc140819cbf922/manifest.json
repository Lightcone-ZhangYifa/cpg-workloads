    "usage": {
      "activation": [
        "Use the Python PackageManager API to install an explicit artifact into an independent prefix."
      ],
      "documentation": [
        "https://github.com/atf-tuner/pyATF"
      ],
      "examples": [
        {
          "command": "python3 -S {prefix}/check.py --prefix {prefix} --work /your/external/check-directory",
          "description": "Run a fresh external-work functional check"
        }
      ],
      "locations": [
        {
          "label": "profile",
          "path": "{prefix}/profile.json",
          "purpose": "Exact private input and runtime contract"
        },
        {
          "label": "examples",
          "path": "{prefix}/samples",
          "purpose": "Real kernel and independent correctness harnesses"
        }
      ],
      "notes": [
        "Reference distribution is descriptive. Actual OS, architecture, interpreter and library loading are checked.",
        "Full original source archives and exact wheels are retained in the source artifact. Optional execution subtrees do not claim complete upstream benchmark coverage.",
        "CPU OpenCL execution does not qualify CUDA or physical GPU execution. No system profiler is used."
      ],
      "summary": "Locked offline pyatf integration with bounded real CPU functional checks."
    },
