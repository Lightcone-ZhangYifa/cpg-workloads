  "package": {
    "build": "cpg-worker084-cpu-v1",
    "checks": [
      {
        "argv": [
          "python3",
          "-S",
          "{prefix}/check.py",
          "--prefix",
          "{prefix}",
          "--work",
          "{build}/functional-checks"
        ],
        "cwd": "{build}",
        "expected_returncode": 0,
        "id": "real-functional",
        "kind": "functional",
        "stdout_regex": "\"status\": \"passed\"",
        "timeout_seconds": 900
      }
    ],
    "dependencies": {
      "build": [],
      "run": [],
      "system": []
    },
    "id": "pyatf",
    "metadata": {
      "baseline_version": "0.21.14",
