      "runtime_contract": {
        "arch": "x86_64",
        "host_commands": [
          "python3"
        ],
        "native_runtime": [
          "glibc"
        ],
        "opencl": null,
        "os": "linux",
        "python": "CPython 3.12"
      },
      "scope": "conditional small CPU/OpenCL-CPU validation; no GPU, OCI, official benchmark score or MPI qualification",
      "worker_id": "worker 084"
    },
    "provider": "source",
    "recipe": {
      "adapter": "commands",
      "install_argv": [
        "python3",
        "-S",
