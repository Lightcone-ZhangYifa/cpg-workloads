    "usage": {
      "activation": [
        "No shell activation is required. Use the recorded Python environment interpreter explicitly."
      ],
      "documentation": [
        "https://github.com/eliben/pyelftools",
        "https://github.com/eliben/pyelftools/blob/main/doc/user-guide.md"
      ],
      "examples": [
        {
          "command": "{prefix}/bin/python -c \"from elftools.elf.elffile import ELFFile; f=open('program','rb'); e=ELFFile(f); print(e['e_machine'], e.get_section_by_name('.text').data_size)\"",
          "description": "Inspect an ELF machine type and code section size."
        },
        {
          "command": "cpg packages check py.pyelftools --prefix {prefix} --kind functional",
          "description": "Run the ELF, symbol and DWARF line-table qualification in the selected environment."
        }
      ],
      "locations": [
        {
          "label": "Python interpreter",
          "path": "{prefix}/bin/python",
          "purpose": "Interpreter owning this exact pyelftools distribution."
        },
        {
          "label": "Python environment",
          "path": "{prefix}",
          "purpose": "Use cpg packages paths py.pyelftools --files for the manager-recorded distribution files."
        }
      ],
      "notes": [
        "The functional check compiles and executes a small x86-64 C fixture, then verifies named symbols, DWARF function metadata and source line mapping; cc must be available.",
        "The check also rejects a stripped fixture. It establishes these operations for the recorded compiler output, not every ELF/DWARF dialect.",
        "Python virtual environments are independent copies. Removing this wrapper removes the distribution, not its containing environment.",
        "All immutable wheel bytes are delivered. Use scripts/lifecycle.py with local source_overrides and a network-denied process.",
        "Original provider identity remains canonical; no APT installation is performed."
      ],
      "summary": "Parse ELF headers, sections, symbols, relocations and DWARF debug/line information from Python; inspect compiler output without scraping text tools."
    },
