    "metadata": {
      "baseline_version": "0.21.14",
      "formal_qualification_promotion": false,
      "license_note": "ISA-tools: BSD-3-Clause. Z3: MIT. Original dependency archives and Ubuntu copyright files retained; see payload/licenses and individual source notices.",
      "plan_id": "cpg-resource-research-20261101-v1",
      "qualification_scope": "Fixed commit 16260979137c38339743a04b7fd5d9f0fa8a6ee5 original toy architecture: iii interpretation and freshly generated fallback C execution; 3 programs, 16 independent literal state observations per model, 5 negative controls; final relocatable default prefix. Preview, finite-model scope; not a whole-language or general compiler-equivalence proof.",
      "record_id": "review.engineering.isa-tools",
      "source_build_verified": true,
      "source_material_scope": "Complete original fixed ISA-tools source plus locked official Z3 release, OCaml/opam dependency inputs, original host dependency packages including exact GMP6.3.0-2ubuntu6 closure, and explicitly local minimal-repository snapshot. Parent source-lock binds 70 actual inputs / 98,073,224 bytes; derived repository snapshot has url=null, not an official-release label.",
      "worker_id": "worker 059"
    },
    "provider": "binary",
