        "path": "{prefix}/share/qbe/source",
        "purpose": "All locked release files; no dependency on the build directory."
      },
      {
        "label": "Installed functional checks",
        "path": "{prefix}/share/compiler-playground/qbe/check.py",
        "purpose": "Repeat compilation/rejection or upstream-test checks without the package state directory."
