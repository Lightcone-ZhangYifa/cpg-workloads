      "examples": [
        {
          "command": "g++ -std=c++17 -I'{prefix}/include' app.cpp '{prefix}/lib/libsimdjson_static.a' -pthread -o app",
          "description": "Build a static C++ consumer."
        },
        {
          "command": "cmake -S . -B build -DCMAKE_PREFIX_PATH='{prefix}'",
          "description": "Discover the simdjson CMake package and its exported target."
        },
        {
          "command": "python3 '{recipe}/check.py' --prefix '{prefix}' --case api",
          "description": "Compare actual DOM results against Python json for each runtime-supported implementation and test the On-Demand API."
