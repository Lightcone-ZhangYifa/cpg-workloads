  "method": "source",
  "package": {
    "build": "cpg-worker084-cpu-v1",
    "checks": [
      {
        "argv": [
          "python3",
          "-S",
          "{prefix}/check.py",
          "--prefix",
          "{prefix}",
          "--work",
          "{build}/functional-checks"
        ],
        "cwd": "{build}",
        "expected_returncode": 0,
        "id": "real-functional",
        "kind": "functional",
        "stdout_regex": "\"status\": \"passed\"",
        "timeout_seconds": 900
      }
    ],
    "dependencies": {
      "build": [],
      "run": [],
      "system": []
    },
    "id": "cltune",
    "metadata": {
      "baseline_version": "0.21.14",
      "canonical_commit": "8a56a4a314be7ccef56ad8f55e8a34a37dda0545",
      "new_candidate": true,
      "package_manager": "original compiler_playground 0.21.14 APIs; no controller changes",
      "record_id": "review.optimization.cltune",
      "runtime_contract": {
        "arch": "x86_64",
        "host_commands": [
          "python3"
        ],
        "native_runtime": [
          "glibc",
          "libstdc++.so.6"
        ],
        "opencl": "actual system libOpenCL.so.1 plus bundled PoCL CPU ICD; no GPU qualification",
        "os": "linux",
        "python": "CPython 3.12"
      },
      "scope": "conditional small CPU/OpenCL-CPU validation; no GPU, OCI, official benchmark score or MPI qualification",
      "worker_id": "worker 084"
    },
    "provider": "source",
    "recipe": {
      "adapter": "commands",
      "install_argv": [
        "python3",
        "-S",
        "{recipe}/install.py",
        "--prefix",
        "{prefix}",
        "--build",
        "{build}",
        "--assets",
        "{assets}",
        "--recipe",
        "{recipe}"
      ],
      "required_host_commands": [
        "python3",
        "gcc",
        "g++",
        "make"
      ],
      "required_runtime_commands": [
        "python3"
      ],
      "working_directory": "{build}"
    },
