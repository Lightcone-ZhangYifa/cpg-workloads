    "provider": "source",
    "recipe": {
      "adapter": "commands",
      "binary_policy": "Interpreted script deployment with the unchanged exact private Debian Perl closure; no machine-code compilation claim.",
      "commands": [
        [
          "/usr/bin/python3",
          "{recipe}/build.py",
          "--source",
          "{source}",
          "--prefix",
          "{prefix}",
          "--build",
          "{build}"
        ]
      ],
      "required_installed_paths": [
        "{prefix}/flamegraph.pl",
        "{prefix}/bin/flamegraph",
        "{prefix}/bin/flamegraph-perl",
        "{prefix}/share/flamegraph/profile.json"
      ],
      "runtime_environment": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "target_exports": [
        {
          "destination": "opt/research/selected/flamegraph",
          "kind": "tree",
          "required": true,
          "role": "profiler",
          "source": "{prefix}"
        }
      ],
      "target_smoke_commands": [
