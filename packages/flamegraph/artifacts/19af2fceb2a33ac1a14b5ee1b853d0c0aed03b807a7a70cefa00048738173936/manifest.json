        ],
        "source_url": "https://codeload.github.com/brendangregg/FlameGraph/tar.gz/41fee1f99f9276008b7cd112fca19dc3ea84ac32",
        "title": "FlameGraph stack visualization",
        "upstream": "https://github.com/brendangregg/FlameGraph",
