    "activation": [
      "Use the resolved absolute command paths shown here. No system-wide PATH or alternatives changes are made."
    ],
    "documentation": [
      "https://github.com/intel/perfmon"
    ],
    "examples": [
      {
        "command": "head -n 12 {prefix}/mapfile.csv",
        "description": "Inspect CPU model mappings"
      },
      {
        "command": "python3 -m json.tool {prefix}/SKX/events/skylakex_core.json",
        "description": "Inspect one documented CPU event table"
      }
    ],
    "locations": [
      {
        "label": "CPU model map",
        "path": "{prefix}/mapfile.csv",
        "purpose": "Map CPU model/stepping identifiers to event JSON files"
      },
      {
        "label": "Event tables",
        "path": "{prefix}",
        "purpose": "Complete pinned upstream event and metric definitions"
      }
    ],
    "notes": [
      "The functional check verifies every mapfile-referenced table and parses its JSON. The hardware check separately reports whether the visible CPU has a map entry.",
      "An AMD CPU produces a blocked Intel-map capability result; this does not mean that the Intel data package failed to install.",
      "CPU model match is not counter qualification. Match stepping and hybrid PMU type before collecting events.",
      "The existing seed-pmu-cache tool can prepare pmu-tools lookup from these local tables without a runtime download."
    ],
    "summary": "Pinned Intel CPU event definitions for local event lookup and pmu-tools cache preparation."
