    "usage": {
      "activation": [],
      "documentation": [
        "https://github.com/data61/MP-SPDZ/tree/v0.4.4",
        "https://mp-spdz.readthedocs.io/"
      ],
      "examples": [
        {
          "command": "python3 -S -B {recipe}/check.py --prefix {prefix} --output ./mpspdz-check",
          "description": "Independent check with fresh output directory"
        },
        {
          "command": "python3 -S -B {recipe}/check.py --prefix {prefix} --output ./mpspdz-tutorial --full-tutorial",
          "description": "Complete unchanged official tutorial"
        }
      ],
      "locations": [
        {
          "label": "compiler",
          "path": "{prefix}/compile.py",
          "purpose": "Upstream Python-to-MPC bytecode compiler"
        },
        {
          "label": "MASCOT runtime",
          "path": "{prefix}/bin/mascot-party.x",
          "purpose": "Official two-party-capable native virtual machine"
        },
        {
          "label": "tutorial",
          "path": "{prefix}/Programs/Source/tutorial.mpc",
          "purpose": "Unmodified official tutorial"
        }
      ],
      "notes": [
        "Requires Linux x86_64 CPU ADX/AVX2/BMI2/AES/PCLMULQDQ and a compatible glibc host.",
        "Installation checks compile and run a small input-sensitive program with 3 synthetic input pairs; the unchanged upstream tutorial is separately replayable with --full-tutorial.",
        "MASCOT malicious/dishonest-majority protocol with 2 parties, 127-bit prime 2^127-1, integer bit length 64, statistical security 40, encrypted channels.",
        "The trusted LD_PRELOAD transport adapter restricts libc connect/bind to loopback; this is not an adversarial network sandbox.",
        "No external peer, actual privacy data, performance claim, production security certification, or native upstream source-build claim."
      ],
      "summary": "MP-SPDZ 0.4.4 upstream Python compiler and official Linux-adx MASCOT runtime, for local two-party synthetic input experiments."
    },
