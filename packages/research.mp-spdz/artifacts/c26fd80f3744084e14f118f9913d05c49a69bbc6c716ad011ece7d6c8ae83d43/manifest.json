  "package": {
    "build": "upstream-linux-adx-cpg1",
    "checks": [
      {
        "argv": [
          "python3",
          "-S",
          "-B",
          "{recipe}/check.py",
          "--prefix",
          "{prefix}",
          "--output",
          "{build}/functional",
          "--payload-lock-sha256",
          "9353b05401d9d5a76ce87ec27743a0a3d8ecbc6ccb71ce02336138c18d865784"
        ],
        "cwd": "{build}",
        "expected_returncode": 0,
        "id": "mascot-two-party",
        "kind": "functional",
        "requires_commands": [
          "python3",
          "openssl"
        ],
        "requires_paths": [
          "{prefix}/bin/mascot-party.x",
          "{prefix}/PAYLOAD_LOCK.json"
        ],
        "stdout_regex": "PASS: mp-spdz MASCOT",
        "timeout_seconds": 1200
      }
    ],
    "dependencies": {
      "build": [],
      "run": [],
      "system": []
    },
    "id": "research.mp-spdz",
    "metadata": {
      "cpg_guard_built_from_source": true,
      "license": "BSD-3-Clause with retained upstream third-party notices",
      "plan_id": "cpg-resource-research-20261101-v1",
      "record_id": "review.optimization.mp-spdz",
      "scope": "Two-party localhost functionality only; not a cryptographic security proof",
      "upstream_binary_build": true,
      "upstream_source_build": false,
      "worker_id": "worker 073"
    },
    "provider": "binary",
    "recipe": {
      "required_runtime_commands": [
        "python3",
        "openssl"
      ],
      "runtime_environment": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1"
      }
    },
    "schema_version": 1,
    "sources": [
