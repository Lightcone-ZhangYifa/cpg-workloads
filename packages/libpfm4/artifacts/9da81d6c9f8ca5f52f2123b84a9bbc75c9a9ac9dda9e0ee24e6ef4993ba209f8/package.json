  "usage": {
    "activation": [
      "Use these absolute executable paths. showevtinfo and check_events contain the upstream static libpfm library; libpfm-api-check uses $ORIGIN/../lib RUNPATH for the dynamic copy.",
      "For custom C programs, compile with -I<prefix>/include and link with -L<prefix>/lib -lpfm. Select a suitable RUNPATH or use a command-local LD_LIBRARY_PATH=<prefix>/lib when running your own executable.",
      "No global ldconfig, PATH, alternatives or loader-cache changes are made."
    ],
    "documentation": [
      "https://perfmon2.sourceforge.net/",
      "https://perfmon2.sourceforge.net/manv4/libpfm.html"
    ],
    "examples": [
      {
        "command": "{prefix}/bin/showevtinfo -E",
        "description": "List encoded named events"
      },
      {
        "command": "{prefix}/bin/showevtinfo",
        "description": "Inspect event definitions"
      },
      {
        "command": "{prefix}/bin/check_events PERF_COUNT_HW_CPU_CYCLES PERF_COUNT_SW_TASK_CLOCK",
        "description": "Encode two generic perf events without opening a counter"
      },
      {
        "command": "{prefix}/bin/libpfm-api-check",
        "description": "Run the C API probe using the library beside this executable"
      },
      {
        "command": "python3 {prefix}/share/compiler-playground/libpfm4/check.py --prefix {prefix} --check compile-link",
        "description": "Compile, link and run the installed C example with this prefix"
      }
    ],
    "locations": [
      {
        "label": "Event encoder",
        "path": "{prefix}/bin/showevtinfo",
        "purpose": "Installed event enumeration and encoding utility"
      },
      {
        "label": "C API",
        "path": "{prefix}/include/perfmon",
        "purpose": "libpfm4 public headers"
      },
      {
        "label": "Library",
        "path": "{prefix}/lib",
        "purpose": "Source-built libpfm4 runtime"
      },
      {
        "label": "Public C API probe",
        "path": "{prefix}/bin/libpfm-api-check",
        "purpose": "Runs three exact generic perf event encodings and reports the actual dynamic library path"
      },
      {
        "label": "Reusable API source and checks",
        "path": "{prefix}/share/compiler-playground/libpfm4",
        "purpose": "Small compile/link example and installed validation script"
      },
      {
        "label": "Upstream validator",
        "path": "{prefix}/bin/libpfm-validate",
        "purpose": "Validates upstream event tables and software encoding test cases; does not collect counters"
      },
      {
        "label": "Manual pages",
        "path": "{prefix}/share/man/man3",
        "purpose": "Upstream public C API and supported PMU manuals"
      },
      {
        "label": "License and README",
        "path": "{prefix}/share/doc/libpfm4",
        "purpose": "Original upstream documentation retained with the package"
      }
    ],
    "notes": [
      "Event encoding succeeds independently of perf_event permission. Positive counter collection is a separate hardware check.",
      "The stable 4.13.0 event database may not identify a newer CPU; do not equate generic event support with model-specific coverage.",
      "pfm_get_version reports the library API version 4.0 in upstream 4.13.0. Release identity comes from the exact source archive and installed libpfm.so.4.13.0, not from inventing a different API version.",
      "Upstream installs no pkg-config .pc or libtool .la files in this profile. Use explicit include/library paths for custom builds.",
      "The prepared profile includes static/shared C libraries, headers, upstream manuals, event utilities, validator, and the C API probe; optional upstream Python bindings are not built.",
      "The dynamic API probe clears ambient LD_LIBRARY_PATH/LD_PRELOAD in the package check so a foreign libpfm cannot satisfy this installation check."
    ],
    "summary": "Encode named PMU/perf events, inspect CPU event databases, and link the libpfm4 C API without opening hardware counters."
  },
  "version": "4.13.0"
}
