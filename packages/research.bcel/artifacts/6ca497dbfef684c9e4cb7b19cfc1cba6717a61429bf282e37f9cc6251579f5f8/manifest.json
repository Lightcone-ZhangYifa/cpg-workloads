      "resource_metadata": {
        "build_claim": false,
        "compiler_license": "EPL-2.0; source JAR retained",
        "description": "读取Java class属性并将一条ICONST_1改为ICONST_2；JVM运行得到1→2，并拒绝截断class和非法栈类型。",
        "functional_claim": true,
        "id": "research.bcel",
        "limitations": [
          "仅覆盖随包小型功能profile，不代表上游全部测试或任意字节码变换正确。",
          "Java17或更新JRE为宿主条件；探针编译使用随包ECJ3.37.0，目标classfile为Java8/major52。",
          "上游库采用锁定官方Maven二进制；本轮从源码编译的是探针，没有声明从源码重建上游库。"
        ],
        "method": "binary",
        "probe_build": "bundled ECJ compiles probe sources on each offline check",
