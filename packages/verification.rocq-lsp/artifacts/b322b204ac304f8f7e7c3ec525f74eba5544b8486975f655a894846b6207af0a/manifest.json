      "proof_gates": [
        "runtime-version exit",
        "fixed Coq and OCaml version",
        "state read from real proof file",
        "actual theorem goal returned",
        "incorrect tactic yields protocol error",
        "valid proof step accepted",
        "state changed after proof step",
        "proof reaches Qed",
        "interactive Qed branch has no axioms",
        "Admitted accepted as finished state and explicitly recorded",
        "interactive Admitted branch is an axiom",
        "kernel-proof exit",
        "Qed proof independently closed",
        "AdmittedCase exit",
        "Admitted recognized as axiom rather than proven",
        "coqchk exit"
