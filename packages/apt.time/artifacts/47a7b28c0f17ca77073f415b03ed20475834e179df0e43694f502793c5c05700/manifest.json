      ],
      "documentation": [
        "https://www.gnu.org/software/time/manual/time.pdf",
        "https://packages.ubuntu.com/noble/time"
      ],
      "examples": [
        {
          "command": "/usr/bin/time -v -o resource-usage.txt ./program",
          "description": "Write verbose resource accounting to a separate file while preserving program stdout."
        },
        {
          "command": "/usr/bin/time -f 'wall_seconds=%e user_seconds=%U system_seconds=%S max_rss_kib=%M exit=%x' -o resource-usage.txt ./program",
          "description": "Write selected measurements with explicit units and the child exit code."
        }
      ],
      "locations": [
        {
          "label": "GNU time",
          "path": "/usr/bin/time",
          "purpose": "External GNU time executable managed by APT."
        }
      ],
      "notes": [
        "On Linux, %M is maximum resident set size in KiB. Timing/resource samples are auxiliary observations and do not replace an official benchmark protocol.",
        "The functional check runs allocating Python children exiting 0 and 7, validates resource fields and confirms both child stdout and exit status are preserved.",
        "Some distribution builds print UNKNOWN as their upstream GNU time version; the exact Ubuntu package version and archive hash remain the package identity."
      ],
      "summary": "Measure child wall time, CPU time and peak resident memory with GNU time; preserve the child exit status for experiment diagnostics."
