    "usage": {
      "activation": [],
      "documentation": [
        "https://github.com/aras-p/ClangBuildAnalyzer"
      ],
      "examples": [
        {
          "command": "'{prefix}/bin/ClangBuildAnalyzer' --version",
          "description": "Run the recorded version check."
        },
        {
          "command": "'{prefix}/bin/ClangBuildAnalyzer' --start ./build",
          "description": "Start a timestamp-bounded capture before compiling with a separately installed Clang and -ftime-trace."
        },
        {
          "command": "'{prefix}/bin/ClangBuildAnalyzer' --stop ./build capture.bin",
          "description": "Collect compatible traces changed within the recorded build session."
        },
        {
          "command": "'{prefix}/bin/ClangBuildAnalyzer' --all ./build capture.bin",
          "description": "Alternatively collect every compatible trace recursively, regardless of timestamps."
        },
        {
          "command": "'{prefix}/bin/ClangBuildAnalyzer' --analyze capture.bin",
          "description": "Analyze frontend, backend, template and header costs. Put a copy of the retained ClangBuildAnalyzer.ini in the current directory to configure reporting."
        },
        {
          "command": "python3 '{recipe}/check.py' --prefix '{prefix}' --case upstream-tests",
          "description": "Run all ten exact upstream fixtures in writable scratch copies, preserving original expected outputs and installed material."
        }
      ],
      "locations": [
        {
          "label": "Prepared material",
          "path": "{assets}/sources/clang-build-analyzer",
          "purpose": "Independent verified source, input, data or upstream distribution."
        },
        {
          "label": "Installation prefix",
          "path": "{prefix}",
          "purpose": "The selected version's independently installed files."
        },
        {
          "label": "Original sources and official fixtures",
          "path": "{prefix}/share/clang-build-analyzer/source",
          "purpose": "Complete original source including all ten trace/expected-output fixtures, third-party license files, platform build projects and sample ClangBuildAnalyzer.ini."
        }
      ],
      "notes": [
        "Original catalog facts, source archive identity and target/export capabilities remain unchanged. The package source and binary profiles retain all original upstream files.",
        "Upstream --test can return zero for an empty or nonexistent test directory. The installed check requires exactly ten pinned fixtures, nonempty original expected outputs, actual execution of ten tests and matching output bytes.",
        "Official fixture checks execute on writable scratch copies: the original test oracles and installed source tree are never rewritten.",
        "The functional workflow also checks --start/--stop timestamp selection, recursive --all, capture-file analysis and errors using explicitly synthetic trace durations. These tests are not measurements of a compiler or physical system.",
        "Clang is not needed to analyze existing traces. Producing new traces requires a compatible separately installed Clang with -ftime-trace. This profile does not run a new Clang compilation, linking/LTO analysis or a full OCI build.",
        "CMake/Ninja are build-only and can use exact private Debian bindings during maintainer replay. Existing system build tools and runtime libraries are recorded without claiming a complete pinned APT installation."
      ],
      "summary": "Aggregate Clang time-trace files to diagnose frontend, template, header and backend compilation costs. Compiler development throughput is a diagnostic metric; generated-program runtime remains the primary objective."
    },
