    "usage": {
      "activation": [],
      "documentation": [
        "https://github.com/google/benchmark/blob/main/docs/reducing_variance.md",
        "https://github.com/google/benchmark/blob/main/docs/user_guide.md"
      ],
      "examples": [
        {
          "command": "g++ -std=c++17 -O2 -I'{prefix}/include' bench.cpp '{prefix}/lib/libbenchmark_main.a' '{prefix}/lib/libbenchmark.a' -pthread -lrt -o bench",
          "description": "Build a benchmark without your own main() using the installed static libraries."
        },
        {
          "command": "./bench --benchmark_filter=MyCase --benchmark_repetitions=5 --benchmark_out=results.json --benchmark_out_format=json",
          "description": "Run your own workload using upstream reporting and explicit controls."
        },
        {
          "command": "cmake -S . -B build -DCMAKE_PREFIX_PATH='{prefix}'",
          "description": "Use find_package(benchmark CONFIG REQUIRED) and the exported CMake targets."
        },
        {
          "command": "PKG_CONFIG_PATH='{prefix}/lib/pkgconfig' pkg-config --cflags --libs --static benchmark_main",
          "description": "Query the location-relative installed pkg-config metadata when pkg-config is available."
        },
        {
          "command": "python3 '{recipe}/check.py' --prefix '{prefix}' --case compile-link-json",
          "description": "Compile/link real consumers, require nonempty structured execution results and reject unknown flags."
        }
      ],
      "locations": [
        {
          "label": "C++ API headers",
          "path": "{prefix}/include/benchmark",
          "purpose": "Registration, fixtures, timing, custom counters and optimization barriers."
        },
        {
          "label": "Static libraries and CMake/pkg-config metadata",
          "path": "{prefix}/lib",
          "purpose": "libbenchmark.a and libbenchmark_main.a, benchmark::benchmark and benchmark::benchmark_main CMake targets; location-relative .pc prefixes."
        },
        {
          "label": "Installed upstream tests",
          "path": "{prefix}/libexec/google-benchmark",
          "purpose": "Standalone upstream test binaries built without GoogleTest or hardware PMU dependencies."
        },
        {
          "label": "Complete locked source",
          "path": "{prefix}/share/google-benchmark/source",
          "purpose": "All original library, test, tool, binding and documentation sources."
        },
        {
          "label": "Upstream analysis scripts",
          "path": "{prefix}/share/googlebenchmark/tools",
          "purpose": "Unmodified upstream Python analysis tools; install their separately declared Python dependencies before use."
        }
      ],
      "notes": [
        "This resource is the Google Benchmark C++ microbenchmark library. Its package smoke timings are not an official compiler Benchmark score and are not evidence of performance improvement.",
        "The distribution profile uses static libraries, C++17, x86-64 baseline code, exceptions enabled and LTO disabled. It preserves the full upstream source and original selector recipe.",
        "GoogleTest-based unit tests, LLVM assembly verification, Rust bindings and libpfm/physical performance counters are not enabled in this profile. Their sources and upstream build options remain available; their qualification is not claimed.",
        "CMake/Ninja are build-only. Matching pinned system tools use the normal path; the maintainer replay can use exact locked private Debian packages as explicit build bindings without an APT transaction.",
        "The installed pkg-config prefix is changed to ${pcfiledir}/../..; upstream library/test source files remain unmodified. CMake imports and prebuilt tests are checked at independent installation prefixes.",
        "The Python comparison scripts are retained as upstream materials. They require the Python dependencies listed in tools/requirements.txt and are not claimed as a ready Python distribution.",
        "For the locked source archive, Git-based version discovery is disabled so an enclosing framework checkout cannot replace the upstream CMake project version."
      ],
      "summary": "Native microbenchmark fixtures with anti-elimination helpers, repetitions and structured result output."
    },
