      "activation": [
        "Use {prefix}/bin/python explicitly; this avoids importing a different ambient installation."
      ],
      "documentation": [
        "https://psutil.io/",
        "https://github.com/giampaolo/psutil"
      ],
      "examples": [
        {
          "command": "{prefix}/bin/python -c \"import psutil; p=psutil.Process(); print(p.memory_info()); print(p.cpu_times())\"",
          "description": "Inspect the current process memory in bytes and cumulative CPU seconds."
        },
        {
          "command": "{prefix}/bin/python -c \"import psutil; print([p.info for p in psutil.process_iter(['pid', 'name', 'memory_info'], ad_value=None)])\"",
          "description": "List process identifiers, names and memory without failing on process races or denied fields."
        },
        {
          "command": "{prefix}/bin/python -c \"import psutil; print(psutil.virtual_memory()); print(psutil.Process().cpu_affinity())\"",
          "description": "Observe system-visible memory and the CPUs allowed for this process."
        },
        {
          "command": "cpg packages check py.psutil --prefix {prefix} --kind functional",
          "description": "Run the declared operation checks in this environment."
        }
      ],
