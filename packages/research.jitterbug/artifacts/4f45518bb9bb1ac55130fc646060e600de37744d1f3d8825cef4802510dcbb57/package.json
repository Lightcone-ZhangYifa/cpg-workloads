  "usage": {
    "activation": [],
    "documentation": [
      "https://github.com/uw-unsat/jitterbug"
    ],
    "examples": [
      {
        "command": "cpg packages check research.jitterbug",
        "description": "Run the declared bounded proof"
      }
    ],
    "locations": [
      {
        "label": "Frozen proof profile",
        "path": "{prefix}/provenance/profile-lock.json",
        "purpose": "Identity and scope of original verifier inputs"
      }
    ],
    "notes": [
      "The declared profile fixes instruction register names only; register values remain symbolic.",
      "The separate full default-register positive proof passed; its later negative run was interrupted, so full-domain negative qualification is not claimed.",
      "Pinned Racket 8.9 CS, Rosette, Serval and Rosette's required Z3 4.8.8 are private to the prefix. Optional documentation omissions are recorded."
    ],
    "summary": "RV64 BPF_ALU/BPF_ADD/BPF_X, dst=r0 and src=r1 with arbitrary symbolic operands and unchanged upstream preconditions; original author bug 1e692f09e091 replay."
  },
