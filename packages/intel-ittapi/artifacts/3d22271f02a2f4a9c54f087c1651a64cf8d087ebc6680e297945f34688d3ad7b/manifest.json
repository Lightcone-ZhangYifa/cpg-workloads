    "target": {
      "arch": "x86_64",
      "distribution": "ubuntu",
      "distribution_version": "24.04",
      "os": "linux"
    },
    "usage": {
      "activation": [
        "For one process, set INTEL_LIBITTNOTIFY64={prefix}/lib/libittnotify_refcol.so and INTEL_LIBITTNOTIFY_LOG_DIR to a newly created writable directory.",
        "Set INTEL_LIBITTNOTIFY_GEN_JSON=1 for JSON; unset it for text. Remove inherited INTEL_LIBITTNOTIFY variables before comparing modes."
      ],
      "documentation": [
        "https://github.com/intel/ittapi/tree/bd72cfb15e34a5fc4c0a8d10f5bb5305d60e1eec",
        "https://gcc.gnu.org/onlinedocs/gfortran/Interoperability-with-C.html"
      ],
      "examples": [
        {
          "command": "cpg packages check intel-ittapi --prefix '{prefix}'",
          "description": "Run all deterministic installed-resource checks."
        },
        {
          "command": "mkdir -p /tmp/ittapi-traces && env INTEL_LIBITTNOTIFY64='{prefix}/lib/libittnotify_refcol.so' INTEL_LIBITTNOTIFY_GEN_JSON=1 INTEL_LIBITTNOTIFY_LOG_DIR=/tmp/ittapi-traces '{prefix}/bin/refcol_smoke_test'",
          "description": "Collect official C smoke events as JSON without global activation."
        },
        {
          "command": "gfortran -I'{prefix}/include/ittapi-fortran' client.f90 '{prefix}/lib/ittfortran.o' -Wl,--whole-archive '{prefix}/lib/libittnotify.a' -Wl,--no-whole-archive -ldl -pthread -o client",
          "description": "Compile a GNU Fortran client; force initialized C pointer slots out of the static library."
        },
        {
          "command": "cpg packages pack --definition resources/packages/intel-ittapi/package.json --method source --source intel-ittapi=/path/to/pinned-ittapi.tar.gz --recipe resources/packages/intel-ittapi/recipe --output ittapi-source.cpgpkg.tar.gz",
          "description": "Prepare a source artifact from the existing native definition."
        },
        {
          "command": "cpg packages pack --definition resources/packages/intel-ittapi/material-profile.json --method material --payload /path/to/extracted-original-source --output ittapi-material.cpgpkg.tar.gz",
          "description": "Prepare the same ID as unmodified source material, without executable installation claims."
        }
      ],
      "locations": [
        {
          "label": "C and C++ headers",
          "path": "{prefix}/include",
          "purpose": "Compile clients using this exact prefix."
        },
        {
          "label": "Native libraries",
          "path": "{prefix}/lib",
          "purpose": "Static ITT/JIT libraries and the reference collector; no global loader changes."
        },
        {
          "label": "GNU Fortran modules",
          "path": "{prefix}/include/ittapi-fortran",
          "purpose": "Compiler-specific .mod files produced by GNU Fortran 13.3.0."
        },
        {
          "label": "Original Fortran sources",
          "path": "{prefix}/share/ittapi/fortran",
          "purpose": "Unmodified pinned Intel source for other compilers or local adaptation."
        },
        {
          "label": "GNU adaptation",
          "path": "{prefix}/share/ittapi/fortran-gnu",
          "purpose": "Generated portable copies and exact adaptation manifest; public integer lock IDs retained."
        },
        {
          "label": "License texts",
          "path": "{prefix}/share/ittapi/LICENSES",
          "purpose": "Upstream dual-license material."
        },
        {
          "label": "Upstream CMake package",
          "path": "{prefix}/lib/cmake/ittapi",
          "purpose": "Use CMAKE_PREFIX_PATH and find_package(ittapi CONFIG REQUIRED). Header ABI/config version is 3.0.0; source release is 3.28.4."
        },
        {
          "label": "Collector and ABI qualification",
          "path": "{prefix}/share/ittapi/qualification",
          "purpose": "Unchanged official oracle, exact eight C++ regression binaries, native probes, and explicitly identified Advisor ABI fixture."
        },
        {
          "label": "Profile",
          "path": "{prefix}/share/ittapi/profile.json",
          "purpose": "Release, header ABI, module compiler and explicit qualification limitations."
        }
      ],
      "notes": [
        "The source lock, complete original catalog metadata and old target export/smoke contract are preserved. baseline-package.json is the exact prior source definition; material-profile.json is an accessible derived material view, not a renamed or discarded source capability.",
        "Source and binary are explicit methods of the same ID. The maintainer replay builds, tests and packages the installed payload and validates two independent binary prefixes; prebuilt copies require the declared Ubuntu 24.04 x86_64 runtime.",
        "Build prerequisites are exact existing wrappers. Private build-tool bindings are explicit .deb extraction, not APT installation or qualification of the full APT dependency closure.",
        "The unmodified official collector oracle validates actual trace contents, including the negative case of a missing collector; process exit zero alone is insufficient.",
        "The generated GNU module adaptations preserve Intel originals. GNU .mod files are compiler-specific. Rebuild for other compilers. The original default-integer Advisor lock ID API remains a limited integer ID interface, not a new full-address API.",
        "Advisor __itt_model_* functions are not implemented by the reference collector. The typed ABI fixture tests adaptation and safe no-op fallback; it is not Intel Advisor or VTune and does not provide profiling data.",
        "No Python distribution is silently installed: the separate alternative wheel version is 1.2.2. Optional Intel PT remains the unchanged upstream OFF default.",
        "This profile records source release 3.28.4 and the actual upstream header/config ABI 3.0/3.0.0 separately. No measured performance score or hardware qualification is claimed."
      ],
      "summary": "Pinned native ITT C/C++ SDK, reference collector, JIT library, and reviewed GNU Fortran 13 modules. Query this record for exact paths and collector activation."
    },
