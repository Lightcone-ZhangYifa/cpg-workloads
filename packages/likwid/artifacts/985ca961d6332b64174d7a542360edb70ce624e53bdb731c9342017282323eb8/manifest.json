        "build_peak_bytes": null,
        "category": [
          "Profiling",
          "PMU collectors"
        ],
        "container_strategy": "Build CPU tools and the access daemon in dev; deploy target tools plus a separately reviewed host access-daemon profile. Keep perf_event and MSR/PCI access modes available. Do not install setuid helpers implicitly.",
        "dependencies": [
          "apt.build-essential",
          "apt.perl"
        ],
        "deployment": {
