            "target": []
          },
          "build_argv": [
            "make",
            "-C",
            "{build}",
            "-j{jobs}",
            "PREFIX={prefix}",
            "COMPILER=GCC",
            "ACCESSMODE=accessdaemon",
            "BUILDDAEMON=true",
            "BUILD_SYSFEATURES=true",
            "NVIDIA_INTERFACE=false",
            "ROCM_INTERFACE=false"
          ],
          "build_role": "dev",
          "configure_argv": [],
          "host_install_review": [
            "likwid-accessD",
            "msr module",
            "PCI device access"
          ],
          "install_argv": [
            "make",
            "-C",
            "{build}",
            "PREFIX={prefix}",
            "COMPILER=GCC",
            "ACCESSMODE=accessdaemon",
            "BUILDDAEMON=true",
            "BUILD_SYSFEATURES=true",
            "NVIDIA_INTERFACE=false",
            "ROCM_INTERFACE=false",
            "install"
