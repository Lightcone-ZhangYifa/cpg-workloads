    "target": {
      "arch": "x86_64",
      "distribution": "ubuntu",
      "distribution_version": "24.04",
      "os": "linux"
    },
    "usage": {
      "activation": [
        "Use the resolved absolute command paths shown here. No system-wide PATH or alternatives changes are made."
      ],
      "documentation": [
        "https://github.com/RRZE-HPC/likwid",
        "https://github.com/RRZE-HPC/likwid/wiki"
      ],
      "examples": [
        {
          "command": "{prefix}/bin/likwid-topology",
          "description": "Inspect CPU and cache topology"
        },
        {
          "command": "{prefix}/bin/likwid-bench -a",
          "description": "Inspect available benchmark kernels"
        },
        {
          "command": "{prefix}/bin/likwid-perfctr -a",
          "description": "List counter groups for this CPU"
        }
      ],
      "locations": [
        {
          "label": "LIKWID tools",
          "path": "{prefix}/bin",
          "purpose": "Version-specific topology, affinity, perfctr and benchmark commands"
        },
        {
          "label": "Metric groups",
          "path": "{prefix}/share/likwid",
          "purpose": "Architecture-specific performance groups and reference data"
        },
        {
          "label": "Installed API examples and checks",
          "path": "{prefix}/share/compiler-playground/likwid",
          "purpose": "Read-only API client source and the resource check entry point; runtime reports keep hardware limitations explicit."
        }
      ],
      "notes": [
        "The source recipe selects the accessdaemon backend; usable counters require a separately reviewed host daemon/MSR/PCI arrangement. No daemon is enabled by the check.",
        "The topology check is non-privileged. Benchmark kernels and counter collection are separate, explicit operations.",
        "Source-built LIKWID 5.5.2 and APT LIKWID 5.2.2 can coexist via their distinct command paths.",
        "The access and frequency helpers are included as ordinary 0755 executables. No host ownership/setuid activation, service startup, MSR module loading or device-policy change is performed. A host administrator may configure the documented upstream access mode explicitly.",
        "The complete profile uses independent prefixes with bound relative launchers. Original sources and complete exact private DEBs are retained. Counter collection and privileged daemon activation are not qualified."
      ],
      "summary": "Inspect CPU topology and use LIKWID affinity, counters and microbenchmarks when explicitly requested."
    },
    "version": "5.5.2"
  },
